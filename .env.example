# ezgym 后端环境变量样例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# 加载方式：ezgym/config.py 通过 python-dotenv 读取 .env

# ---- 运行环境 ----
# 选择配置类：development / testing / production
FLASK_CONFIG=development

# ---- Flask / Session ----
# Flask session 签名密钥，务必随机且与 JWT 密钥分离（修 CR：SECRET_KEY 与 SALT 不再同值）
SECRET_KEY=change-me-to-a-random-secret

# ---- JWT ----
# JWT 签名密钥（flask-jwt-extended 使用），必须独立于 SECRET_KEY
JWT_SECRET_KEY=change-me-to-another-random-secret
# access token 有效期（秒），默认 24 小时
JWT_ACCESS_TOKEN_EXPIRES=86400

# ---- 数据库 ----
# SQLAlchemy 连接串，注意 charset=utf8mb4（修 CR #28 emoji 截断）
DATABASE_URL=mysql+pymysql://root:root@localhost/ezgym?charset=utf8mb4

# ---- 邮件（找回密码）----
MAIL_SERVER=smtp.163.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=your_mailbox@163.com
# 邮箱授权码/密码，切勿硬编码进代码（修 CR：163 授权码明文）
MAIL_PASSWORD=your_mail_authorization_code
MAIL_SENDER=your_mailbox@163.com

# ---- 前端 / CORS ----
# 允许跨域的前端域名（带协议与端口）
USER_HOST=http://127.0.0.1:8080

# ---- 媒体文件 ----
# 上传文件落盘目录（缺省为项目下 media/images）
MEDIA_DIR=
MEDIA_URL=/media/images
